[Unit]
Description=GP Robot1 preflight checks (serial names, disk, power, deps)
# Deliberately NOT gated on network-online.target — the checks need no
# network, and gp-robot1 Requires= this unit, so any wait here delays the
# whole stack. network-online's ~120 s wait-online timeout on a slow-WiFi
# boot was pushing startup to ~3 min for a localhost-only DDS stack. Do
# NOT re-add network-online here.

[Service]
Type=oneshot
RemainAfterExit=yes
User=pi
Environment=GP_DIR=/home/pi/GP
ExecStart=/bin/bash /home/pi/GP/robots/robot1/scripts/preflight.sh

[Install]
WantedBy=multi-user.target

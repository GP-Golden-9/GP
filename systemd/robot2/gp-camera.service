[Unit]
Description=GP Robot2 camera publisher (independent of the ROS stack)
# No network-online.target: the publisher binds its ZMQ PUB socket to a
# wildcard and streams the moment a subscriber connects — it doesn't need
# the network "up" to start, and waiting on it added ~3 min of boot delay
# on flaky WiFi (same fix as gp-robot2/gp-preflight). Do NOT re-add it.
# Deliberately NOT bound to gp-robot2.service: video must survive ROS crashes
# and a camera fault must never take down robot control.

[Service]
Type=simple
User=pi
Environment=GP_DIR=/home/pi/GP
WorkingDirectory=/home/pi/GP
ExecStart=/usr/bin/python3 /home/pi/GP/robots/robot2/nodes/camera_pub.py --config /home/pi/GP/config/robot2.yaml
Restart=always
RestartSec=2
MemoryMax=200M

[Install]
WantedBy=multi-user.target
